        <circle cx="558" cy="43" r="1.2" />
        <circle cx="512" cy="131" r="1" />
        <circle cx="594" cy="43" r="1" />
        <circle cx="645" cy="133" r="1.2" />
      </g>
    </mask>
  </defs>
  <g
    mask={`url(#${maskId})`}
    stroke="currentColor"
    stroke-width="7.2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    {glyphs.map((d) => (
      <path d={d} />
    ))}
  </g>
</svg>
