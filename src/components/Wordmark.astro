---

<svg
  class="feedstar-wordmark"
  viewBox="14 18 650 140"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <mask
      id={maskId}
      maskUnits="userSpaceOnUse"
      x="14"
      y="18"
      width="650"
      height="140"
      style="mask-type: luminance"
    >
      <path d="M14 18H664V158H14Z" fill="white" />
      {chips.map(([x, y, rx, ry, angle], index) => (
        <ellipse
          cx={x}
          cy={y}
          rx={rx}
          ry={ry}
          transform={`rotate(${angle} ${x} ${y})`}
          fill={index % 3 === 0 ? '#777' : '#111'}
        />
      ))}
      <g stroke="#111" stroke-width="1.7" stroke-linecap="round">
        <path d="m25 127 6-2m102-26 7 2m73-48 6 2m74 39 6-2m51 4 5 4m53 32 6-2m53-42 6 3m107 41 7-2m78 4 6-3" />
      </g>
      <g fill="#555">
        <circle cx="46" cy="32" r="1" />
        <circle cx="29" cy="94" r="1.1" />
        <circle cx="109" cy="121" r="1.2" />
        <circle cx="153" cy="33" r=".9" />
