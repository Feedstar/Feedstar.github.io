<div
  class="moon-scene"
  id="moon-scene"
  data-boot-scene="moon"
  role="img"
  aria-label="月体右侧明亮、左侧暗蚀，星屑与薄雾向左流动，随滚动聚拢成下一屏文字与入口"
>
  <div class="moon-fallback" aria-hidden="true"></div>
  <canvas id="moon-canvas" aria-hidden="true"></canvas>
</div>
<script>
  import { createMoon } from '../scripts/moon';
  import { createLunarScroll } from '../scripts/lunar-scroll';
  let dispose: (() => void) | undefined;
  function mount() {
    dispose?.();
    const canvas = document.querySelector<HTMLCanvasElement>('#moon-canvas');
    if (canvas) {
      const disposeMoon = createMoon(canvas);
      const disposeScroll = createLunarScroll(
        document.getElementById('orbit-journey')!,
      );
      dispose = () => {
        disposeScroll();
        disposeMoon();
      };
    }
  }
  mount();
  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', () => dispose?.());
</script>
