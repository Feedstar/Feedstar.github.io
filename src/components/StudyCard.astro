---
import ProjectArt from './ProjectArt.astro';
interface Props {
  kind: 'pendulum' | 'actuator' | 'contact';
  number: string;
  title: string;
  english: string;
  description: string;
  tags: string[];
}
const { kind, number, title, english, description, tags } = Astro.props;
---

<article class={`study-card study-${kind}`}>
  <a class="study-link" href={`/lab/?example=${kind}`}>
    <div class="study-window" data-study={kind}>
      <div class="study-art-fallback" aria-hidden="true">
        <ProjectArt kind={kind} />
      </div>
      <canvas class="study-canvas" aria-hidden="true"></canvas>
      <div class="study-topline">
        <span>STUDY / {number}</span>
        <span>MUJOCO EXPLORATIONS</span>
      </div>
      <span class="study-watermark" aria-hidden="true">
        {english}
      </span>
      <div class="study-bottomline">
        <span>{tags.join(' · ')}</span>
        <span class="study-enter" aria-hidden="true">
          ↗
        </span>
      </div>
    </div>
    <div class="study-caption" data-reveal>
      <span class="study-number">{number}</span>
      <div>
        <p class="eyebrow">{english}</p>
        <h3>{title}</h3>
      </div>
      <p class="study-description">{description}</p>
    </div>
  </a>
</article>
<script>
  import { createStudies } from '../scripts/studies';
  createStudies();
</script>
