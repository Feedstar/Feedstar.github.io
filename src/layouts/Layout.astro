---
import '../styles/global.css';
import Wordmark from '../components/Wordmark.astro';
import Footer from '../components/Footer.astro';
import BootHead from '../components/BootHead.astro';
import SiteLoader from '../components/SiteLoader.astro';
import { siteProfile } from '../lib/site-profile';
import { siteNavigation } from '../lib/site-navigation';
const {
  title = 'Feedstar · 微光与秩序',
  description = siteProfile.description,
  page = 'home',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN" data-theme="ink">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#030512" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        const theme = localStorage.getItem('feedstar-theme');
        if (theme === 'paper') {
          document.documentElement.dataset.theme = 'paper';
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute('content', '#eef0f5');
        }
      } catch {}
    </script>
    <BootHead />
  </head>
  <body data-page={page}>
    <SiteLoader />
    <a class="skip-link" href="#main">
      跳到正文
    </a>

    <div class="paper-grain" aria-hidden="true"></div>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Feedstar 首页">
        <span class="brand-lockup">
          <Wordmark />
          <span class="brand-caption">PERSONAL OBSERVATORY</span>
        </span>
      </a>
      <nav aria-label="主导航">
        {siteNavigation.map((item) => (
          <a
            href={item.href}
            aria-current={page === item.page ? 'page' : undefined}
          >
            <span class="nav-number">{item.number}</span> {item.label}
          </a>
        ))}
      </nav>
      <button class="theme-toggle" aria-label="切换明暗主题" title="纸 / 墨">
        <span class="theme-orb"></span>
      </button>
    </header>
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import { startSiteLoader } from '../scripts/site-loader';
      import { createPointer } from '../scripts/pointer';
      import { createTitleMotion } from '../scripts/title-motion';
      import { createChapters } from '../scripts/chapters';
      createPointer();
      createTitleMotion();
      createChapters();
      const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
      toggle?.addEventListener('click', () => {
        const next =
          document.documentElement.dataset.theme === 'paper' ? 'ink' : 'paper';
        document.documentElement.dataset.theme = next;
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute(
            'content',
            getComputedStyle(document.documentElement)
              .getPropertyValue('--bg')
              .trim(),
          );
        try {
          localStorage.setItem('feedstar-theme', next);
        } catch {}
      });
      document.querySelector('.back-top')?.addEventListener('click', () =>
        window.scrollTo({
          top: 0,
          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches
            ? 'instant'
            : 'smooth',
        }),
      );
      const header = document.querySelector('.site-header');
      const updateHeader = () =>
        header?.classList.toggle('is-scrolled', scrollY > 30);
      window.addEventListener('scroll', updateHeader, { passive: true });
      updateHeader();
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries)
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
        },
        { threshold: 0.12 },
      );
      document
        .querySelectorAll('[data-reveal]')
        .forEach((el) => io.observe(el));
      document.addEventListener('visibilitychange', () => {
        document.documentElement.dataset.paused = String(document.hidden);
      });
      startSiteLoader();
    </script>
  </body>
</html>
