---
import { getCollection, render } from 'astro:content';
import { compareDocumentDates } from '../../lib/document-order';
import Layout from '../../layouts/Layout.astro';
import ReadingToc from '../../components/ReadingToc.astro';
import ArticleMasthead from '../../components/ArticleMasthead.astro';
import '../../styles/documents.css';
export async function getStaticPaths() {
  const documents = (await getCollection('docs')).sort(
    compareDocumentDates,
  );
  return documents.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      number: String(index + 1).padStart(2, '0'),
      next: documents[(index + 1) % documents.length],
    },
  }));
}
const { post, number, next } = Astro.props;
const { Content, headings } = await render(post);
---

<Layout
  title={`${post.data.title} · Feedstar`}
  description={post.data.description}
  page="docs"
  article={{
    title: post.data.title,
    category: post.data.category,
    image: post.data.cover,
    width: 1600,
    height: 800,
    publishedDate: post.data.publishedDate,
    updatedDate: post.data.updatedDate,
  }}
>
  <ArticleMasthead
    kind="docs"
    id={post.id}
    title={post.data.title}
    description={post.data.description}
    number={number}
    category={post.data.category}
    cover={post.data.cover}
    publishedDate={post.data.publishedDate}
    updatedDate={post.data.updatedDate}
  />
  <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>
  <div class="reading-layout">
    <ReadingToc headings={headings} backHref="/docs/" backLabel="全部文档" />
    <article class="article-shell document-article">
      <header class="article-header" id="article-start">
        <a class="eyebrow" href="/docs/">
          ← WORK & REFLECTIONS / 工作记录与心得
        </a>
        <div class="document-meta">
          <span>{post.data.category}</span>
          <span>{post.data.tags.join(' · ')}</span>
        </div>
      </header>
      <div class="prose">
        <Content />
      </div>
      <div class="article-bottom">
        <a class="text-link" href="/docs/">
          返回文档 <span>←</span>
        </a>
        <a class="text-link document-next" href={`/docs/${next.id}/`}>
          继续阅读：{next.data.title} <span>↗</span>
        </a>
      </div>
    </article>
  </div>
</Layout>
<script>
  import { createCodeBlocks } from '../../scripts/code-blocks';
  createCodeBlocks();
  // Playing one recording pauses the others; long pages never stack playback.
  document
    .querySelectorAll<HTMLVideoElement>('.document-video video')
    .forEach((video) => {
      video.addEventListener('play', () => {
        document
          .querySelectorAll<HTMLVideoElement>('.document-video video')
          .forEach((other) => {
            if (other !== video) other.pause();
          });
      });
    });
  document.addEventListener('visibilitychange', () => {
    if (document.hidden)
      document
        .querySelectorAll<HTMLVideoElement>('.document-video video')
        .forEach((video) => video.pause());
  });
</script>
