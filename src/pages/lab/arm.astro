---
import Layout from '../../layouts/Layout.astro';
import ArmLab from '../../components/ArmLab';
import '../../styles/arm-lab.css';
---

<Layout
  title="读懂一只机械臂 · Feedstar"
  page="lab"
  description="Feedstar 原创 MuJoCo 教学模型：从刚体与关节，到位置控制、传感器与夹持接触。在浏览器运行，也能下载完整代码。"
>
  <div class="arm-page-intro wrap">
    <a class="arm-back" href="/lab/">
      ← 返回实验室
    </a>
    <div class="arm-page-heading">
      <div>
        <p class="eyebrow">04 / AN ARM, UNDERSTOOD</p>
        <h1>
          一点点，<em>读懂运动。</em>
        </h1>
      </div>
      <p>
        用自己搭建的模型，解释每一次运动。
        <br />
        一只教学机械臂，四个可运行的基础实验。
      </p>
    </div>
    <div class="arm-page-meta">
      <span>FEEDSTAR ORIGINAL</span>
      <span>4 轴机械臂 + 平行夹爪</span>
      <span>MUJOCO / 本地运行</span>
    </div>
  </div>
  <div class="wrap arm-page-content">
    <ArmLab client:load />
    <noscript>
      此实验需要 JavaScript。你也可以
      <a href="/examples/arm-lab.zip" download>
        下载模型与 Python 程序
      </a>
      ，在本地运行。
    </noscript>
  </div>
</Layout>
