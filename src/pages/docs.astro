---
import Layout from '../layouts/Layout.astro';
const topics = [
  {
    number: '01',
    title: '原理与方法',
    description: '技术原理、算法推导与系统性的知识整理。',
  },
  {
    number: '02',
    title: '开发与实践',
    description: '项目说明、实现过程与可复用的开发指南。',
  },
  {
    number: '03',
    title: '工具与环境',
    description: '工具用法、环境配置与日常查阅的操作参考。',
  },
];
---

<Layout
  title="文档 · Feedstar"
  page="docs"
  description="Feedstar 的技术文库。收录技术原理、开发指南与工具参考，整理可以反复查阅的知识。"
>
  <div class="page-intro wrap">
    <p class="eyebrow">03 / TECHNICAL LIBRARY</p>
    <h1>
      技术文库。
      <br />
      <em>把理解，整理成路径。</em>
    </h1>
    <p class="intro-description">
      系统整理技术原理、实践方法与工具参考。
      <br />
      让一次积累，成为下一次出发时可以查阅的路标。
    </p>
  </div>
  <section class="page-content wrap docs-library" aria-labelledby="docs-status">
    <div class="docs-status">
      <p class="eyebrow">THE LIBRARY IS TAKING SHAPE</p>
      <h2 id="docs-status">文档正在整理。</h2>
      <p>
        这里将收录工作与学习中的技术文档。
        <br />
        已有的学习记录与实验心得，可以先在手记中阅读。
      </p>
      <a class="text-link" href="/journal/">
        翻开手记 <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="docs-topics" aria-labelledby="docs-topics-title">
      <p class="eyebrow" id="docs-topics-title">
        收录方向 / SUBJECTS
      </p>
      {topics.map((topic) => (
        <div class="docs-topic">
          <span class="docs-number">{topic.number}</span>
          <div>
            <h3>{topic.title}</h3>
            <p>{topic.description}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .docs-library {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10%;
  }
  .docs-status {
    border-top: 1px solid var(--line);
    padding-top: 30px;
  }
  .docs-status h2 {
    font: 28px/1.6 var(--serif);
    margin: 25px 0 18px;
  }
  .docs-status > p:not(.eyebrow) {
    color: var(--muted);
    font-size: 13px;
    line-height: 2;
  }
  .docs-status .text-link {
    margin-top: 26px;
  }
  .docs-topics > .eyebrow {
    margin-bottom: 24px;
  }
  .docs-topic {
    display: flex;
    gap: 24px;
    border-top: 1px solid var(--line);
    padding: 23px 0;
  }
  .docs-number {
    color: var(--subtle);
    font: 22px/1.7 var(--roman);
  }
  .docs-topic h3 {
    font: 19px/1.8 var(--serif);
  }
  .docs-topic p {
    font-size: 12px;
    line-height: 1.9;
    color: var(--muted);
    margin-top: 6px;
  }
  @media (max-width: 650px) {
    .docs-library {
      grid-template-columns: 1fr;
      gap: 52px;
    }
  }
</style>
