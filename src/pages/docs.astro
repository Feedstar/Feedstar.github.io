---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Archive from '../components/Archive.astro';
const documents = (await getCollection('docs')).sort(
  (a, b) => a.data.order - b.data.order,
);
const groups = ['建模与仿真', '强化学习', '动作模仿'];
const titles: Record<string, string> = {
  'urdf-export-checklist': 'The shape of a robot',
  'gazebo-custom-robot': 'Into the simulation',
  'reinforcement-learning-new-robot': 'Learning to move',
  'mini-pi-plus-beyondmimic': 'Motion, transferred',
  'gvhmr-motion-reconstruction': 'Tracing human motion',
  mimickit: 'A language of movement',
};
const items = documents.map((doc, i) => ({
  id: doc.id,
  ...doc.data,
  number: String(i + 1).padStart(2, '0'),
  english: titles[doc.id],
  group: doc.data.category,
}));
---

<Layout
  title="文档 · Feedstar"
  page="docs"
  description="Feedstar 的工作记录与心得。记录机器人建模、仿真、强化学习与动作模仿的实践过程。"
>
  <Archive kind="docs" items={items} groups={groups} />
</Layout>
