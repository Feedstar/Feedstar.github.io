---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SectionIntro from '../components/SectionIntro.astro';
import DocumentGallery from '../components/DocumentGallery.astro';
const documents = (await getCollection('docs')).sort(
  (a, b) => a.data.order - b.data.order,
);
const groups = ['建模与仿真', '强化学习', '动作模仿'];
const titles: Record<string, string> = {
  'urdf-export-checklist': 'The shape of a robot',
  'gazebo-custom-robot': 'Into the simulation',
  'reinforcement-learning-new-robot': 'Learning to move',
  'mini-pi-plus-beyondmimic': 'Motion, transferred',
  'gvhmr-motion-reconstruction': 'Tracing human motion',
  mimickit: 'A language of movement',
};
const items = documents.map((doc, i) => ({
  id: doc.id,
  ...doc.data,
  number: String(i + 1).padStart(2, '0'),
  english: titles[doc.id],
  group: doc.data.category,
}));
---

<Layout
  title="文档 · Feedstar"
  page="docs"
  description="Feedstar 的工作记录与心得。记录机器人建模、仿真、强化学习与动作模仿的实践过程。"
>
  <SectionIntro
    number="03"
    label="DOCUMENTS"
    first="In the"
    second="making."
    title="文档 / 理解，生长于实践。"
    description="那些走过的步骤，与留下的思考。关于建模、学习，以及让想法发生的过程。"
    detail={String(items.length).padStart(2, '0') + ' RECORDS'}
    href="#archive-index"
    action="浏览文档"
    id="archive-title"
  />
  <DocumentGallery items={items} groups={groups} />
</Layout>
