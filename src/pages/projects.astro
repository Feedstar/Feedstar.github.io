---
import Layout from '../layouts/Layout.astro';
import ExperimentCollection from '../components/ExperimentCollection.astro';
---

<Layout title="探索 · Feedstar" page="projects">
  <div class="page-intro wrap">
    <p class="eyebrow">01 / EXPLORATIONS</p>
    <h1>
      把好奇，
      <br />
      <em>变成可以触碰的东西。</em>
    </h1>
    <p class="intro-description">
      从一个模型、一个参数、一次观察开始。
      <br />
      每个示例，都连接着可运行的实验、解释与源码。
    </p>
  </div>
  <section class="portfolio-field project-archive">
    <div class="wrap">
      <ExperimentCollection />
    </div>
  </section>
</Layout>
