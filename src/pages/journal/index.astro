---
import Layout from '../../layouts/Layout.astro';
import CrystalJournal from '../../components/CrystalJournal.astro';
import { experimentCatalog } from '../../lib/experiment-catalog';
import { getCollection } from 'astro:content';
const posts = (await getCollection('journal')).sort((a, b) =>
  a.data.number.localeCompare(b.data.number),
);
const groups = ['基础现象', '机械臂', '约束与感知'];
const items = posts.map((post) => {
  const entry = experimentCatalog.find((entry) => entry.id === post.id)!;
  return {
    id: post.id,
    ...post.data,
    number: entry.number,
    english: entry.english,
    group: groups[entry.kind === 'basic' ? 0 : entry.kind === 'arm' ? 1 : 2],
  };
});
---

<Layout
  title="手记 · Feedstar"
  page="journal"
  description="MuJoCo 实验的配套文章解析。在现象、原理与代码之间，重新看见细节。"
>
  <CrystalJournal items={items} groups={groups} />
</Layout>
