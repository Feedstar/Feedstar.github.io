---
import Layout from '../layouts/Layout.astro';
import ContentDates from '../components/ContentDates.astro';
import { contentDirectory, kindLabels } from '../lib/content-directory';
import '../styles/discovery.css';
const entries = await contentDirectory();
---

<Layout
  title="搜索 · Feedstar"
  page="search"
  description="在仿真实验、配套手记与工作文档之间，找到一个问题的线索。"
  noindex
>
  <section
    class="discovery-page wrap"
    aria-labelledby="search-title"
    data-search
  >
    <p class="eyebrow">FIND A THREAD / 在记录之间</p>
    <h1 id="search-title">
      循着问题，<em>找到线索。</em>
    </h1>
    <p class="discovery-intro">
      搜索仿真实验、配套手记与工作文档。试试「关节」「奖励」或「MuJoCo」。
    </p>
    <form class="search-form" role="search" action="/search/" method="get">
      <div class="search-query">
        <label for="search-query">搜索内容</label>
        <input
          id="search-query"
          name="q"
          type="search"
          placeholder="一个关键词，也可以是一组问题…"
          maxlength="160"
          autocomplete="off"
        />
      </div>
      <div class="search-kind">
        <label for="search-kind">内容类型</label>
        <select id="search-kind" name="type">
          <option value="all">全部内容</option>
          {Object.entries(kindLabels).map(([value, label]) => (
            <option value={value}>{label}</option>
          ))}
        </select>
      </div>
      <button type="submit">
        查找 <span aria-hidden="true">↗</span>
      </button>
    </form>
    <noscript>
      <p class="discovery-notice">
        当前展示完整目录。启用 JavaScript
        后可搜索正文，也可使用浏览器的“在页面中查找”。
      </p>
    </noscript>
    <div class="search-status-line">
      <p data-search-status role="status" aria-live="polite">
        共 {entries.length} 项内容
      </p>
      <button type="button" data-search-retry hidden>
        重试加载正文索引
      </button>
      <span class="search-shortcut">随时按 Ctrl / ⌘ + K 搜索</span>
    </div>
    <p class="discovery-notice" data-search-error hidden>
      正文索引暂未加载，仍可搜索标题、分类和简介，或直接打开下方内容。
    </p>
    <p class="search-empty" data-search-empty hidden>
      暂时没有匹配的内容。试着缩短关键词，或选择“全部内容”。
    </p>
    <ol class="search-results">
      {entries.map((entry) => (
        <li
          data-search-id={entry.id}
          data-kind={entry.kind}
          data-category={entry.category}
          data-tags={JSON.stringify(entry.tags)}
        >
          <a href={entry.url}>
            <div class="search-result-meta">
              <span>
                {kindLabels[entry.kind]} / {entry.category}
              </span>
              <ContentDates
                publishedDate={entry.publishedDate}
                updatedDate={entry.updatedDate}
              />
            </div>
            <h2>
              {entry.title}
              <span aria-hidden="true">↗</span>
            </h2>
            <p data-search-description>{entry.description}</p>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Layout>
<script>
  import { startSearch } from '../scripts/search';
  startSearch();
</script>
