---
import Layout from '../layouts/Layout.astro';
import LabWorkspace from '../components/LabWorkspace';
import ExperimentCollection from '../components/ExperimentCollection.astro';
import '../styles/lab.css';
import '../styles/arm-lab.css';
import '../styles/lab-course.css';
---

<Layout title="实验室 · Feedstar" page="lab">
  <div class="page-intro wrap lab-page-intro">
    <p class="eyebrow">01 / THE SMALL LABORATORY</p>
    <h1>
      把好奇，
      <br />
      <em>变成可以触碰的东西。</em>
    </h1>
    <p class="intro-description">
      从一个模型、一个参数、一次观察开始。
      <br />
      让抽象的概念，在可运行的程序里变得具体。
    </p>
  </div>
  <section
    class="portfolio-field project-archive"
    id="catalog"
    aria-label="实验目录"
  >
    <div class="wrap">
      <ExperimentCollection />
    </div>
  </section>
  <section class="page-content wrap">
    <LabWorkspace client:visible />
    <noscript>
      <p>
        交互实验需要启用 JavaScript。你可以直接下载
        <a href="/examples/pendulum.xml">单摆模型</a>与
        <a href="/examples/run.py">Python 运行程序</a>。
      </p>
    </noscript>
  </section>
</Layout>

<style>
  #catalog {
    scroll-margin-top: 120px;
  }
</style>
