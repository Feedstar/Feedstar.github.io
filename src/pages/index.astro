---
import Layout from '../layouts/Layout.astro';
import Moon from '../components/Moon.astro';
import StudyCard from '../components/StudyCard.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('journal')).sort((a, b) =>
  a.data.number.localeCompare(b.data.number),
);
---

<Layout>
  <section
    class="orbit-journey"
    id="orbit-journey"
    aria-label="从月体到探索的滚动序章"
  >
    <div class="orbit-sticky">
      <div class="hero-atmosphere" aria-hidden="true"></div>
      <Moon />
      <div class="orbital-lines" aria-hidden="true">
        <span></span>
        <span></span>
        <i>FIELD 001 / LUNAR DUST</i>
      </div>
      <div class="hero-copy wrap">
        <p class="eyebrow hero-eyebrow">
          <i class="status-dot"></i> FEEDSTAR'S PERSONAL OBSERVATORY
        </p>
        <h1>
          <span class="hero-english">
            Curiosity,
            <br />
            <em>in motion.</em>
          </span>
          <span class="hero-chinese">
            在微光里，
            <br />
            让好奇发生。
          </span>
        </h1>
      </div>
      <div class="hero-bottom wrap">
        <a class="scroll-cue" href="#explore">
          <span class="scroll-orb">↓</span>
          <span>
            向下探索<small>SCROLL TO UNFOLD</small>
          </span>
        </a>
        <p class="hero-description">
          写下一点理解。
          <br />
          让一个想法，在这里运行起来。
        </p>
      </div>
      <div class="arrival wrap">
        <p class="eyebrow" data-particle-text>
          01 / FROM WONDER TO UNDERSTANDING
        </p>
        <h2>
          <span data-particle-text>从一个疑问，</span>
          <br />
          <em data-particle-text>到一次发生。</em>
        </h2>
        <div class="arrival-bottom">
          <p>
            <span data-particle-text>把问题拆小，把运动看清。</span>
            <br />
            <span data-particle-text>在思考与实践之间，寻找自己的轨道。</span>
          </p>
          <a class="pill-link" href="#explore" data-particle-border>
            <span data-particle-text>进入探索</span>{' '}
            <span data-particle-text>↘</span>
          </a>
        </div>
      </div>
      <div class="orbit-meter" aria-hidden="true">
        <span id="orbit-progress"></span>
      </div>
      <span class="moon-caption">MOVE GENTLY / 星屑会回应你的靠近</span>
    </div>
  </section>
  <section class="portfolio-field" id="explore">
    <div class="wrap">
      <div class="field-intro">
        <p class="eyebrow" data-reveal>
          01 / SELECTED EXPLORATIONS <span>2026 — ONGOING</span>
        </p>
        <div class="field-title">
          <h2 data-reveal>
            把问题，
            <br />
            <span>交给实验。</span>
          </h2>
          <div data-reveal>
            <p>
              一个模型，一次观察，一点新的理解。
              <br />
              从最小的运动，走进更大的世界。
            </p>
            <a class="text-link" href="/projects/">
              全部探索 <span>↗</span>
            </a>
          </div>
        </div>
      </div>
      <StudyCard
        kind="pendulum"
        number="01"
        english="The shape of time"
        title="时间的形状。"
        description="放开一枚摆，观察阻尼如何让运动慢慢安静。"
        tags={['关节动力学', '阻尼', '能量']}
      />
      <div class="study-duet">
        <StudyCard
          kind="actuator"
          number="02"
          english="A quiet pursuit"
          title="向目标靠近。"
          description="目标、误差与响应，在一段运动里变得具体。"
          tags={['位置执行器', '控制', '响应']}
        />
        <StudyCard
          kind="contact"
          number="03"
          english="Where things meet"
          title="接触的地方。"
          description="让一个方块滑行，看见摩擦留下的痕迹。"
          tags={['接触', '摩擦', '滑动']}
        />
      </div>
      <div class="field-outro" data-reveal>
        <span>THINK. OBSERVE. UNDERSTAND.</span>
        <p>每个示例都有可运行的实验、解释与源码。</p>
        <a href="/lab/" class="pill-link">
          亲手试一次 <span>↗</span>
        </a>
      </div>
    </div>
  </section>
  <section class="notes-field wrap">
    <div class="notes-heading" data-reveal>
      <p class="eyebrow">02 / FIELD NOTES</p>
      <h2>
        沿途的
        <br />
        <em>微光。</em>
      </h2>
      <p>
        一些工作与学习的手记。
        <br />
        把尚未完整的理解，慢慢写清。
      </p>
      <a class="text-link" href="/journal/">
        翻开全部手记 <span>↗</span>
      </a>
      <span class="notes-asterisk" aria-hidden="true">
        ✳
      </span>
    </div>
    <div class="journal-list">
      {posts.map((post) => (
        <a href={`/journal/${post.id}/`} data-reveal>
          <span class="eyebrow">
            {post.data.category} <span>NOTE / {post.data.number}</span>
          </span>
          <h3>{post.data.title}</h3>
          <p>{post.data.description}</p>
          <span class="note-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      ))}
    </div>
  </section>
  <section class="about-fragment wrap" data-reveal>
    <p class="eyebrow">03 / A NOTE FROM FEEDSTAR</p>
    <div class="about-fragment-body">
      <p class="about-quote">
        有些理解，来自阅读。
        <br />
        有些理解，<em>要让它发生一次。</em>
      </p>
      <div>
        <p>
          这里存放工作与学习中的思考、
          <br />
          可视化程序，以及关于运动的小实验。
          <br />
          留一点空间，给新的问题。
        </p>
        <a class="text-link" href="/about/">
          关于这个空间 <span>↗</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
