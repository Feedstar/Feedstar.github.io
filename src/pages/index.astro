---
import Layout from '../layouts/Layout.astro';
import Moon from '../components/Moon.astro';
import ProjectArt from '../components/ProjectArt.astro';
---

<Layout>
  <section
    class="orbit-journey"
    id="orbit-journey"
    aria-label="从月体到探索的滚动序章"
  >
    <div class="orbit-sticky">
      <Moon />
      <div class="orbital-lines" aria-hidden="true">
        <span></span>
        <span></span>
        <i>01 — IN ORBIT</i>
      </div>
      <div class="hero-copy wrap">
        <p class="eyebrow hero-eyebrow">
          A PERSONAL OBSERVATORY <span>·</span> FEEDSTAR
        </p>
        <h1>
          <span class="hero-english">
            A quiet
            <br />
            <em>orbit.</em>
          </span>
          <span class="hero-chinese">
            在微小之处，
            <br />
            理解世界的运转。
          </span>
        </h1>
        <p class="hero-description">
          关于学习、创造，以及那些
          <br />
          值得慢慢弄明白的事。
        </p>
      </div>
      <div class="hero-bottom wrap">
        <span class="small-note">记录思考 / 观察运动 / 构建可能</span>
        <a class="scroll-cue" href="#explore">
          向下，开始探索 <span>↓</span>
        </a>
      </div>
      <div class="arrival wrap">
        <span class="eyebrow">FROM CURIOSITY TO UNDERSTANDING</span>
        <h2>
          让抽象的想法，
          <br />
          <em>有迹可循。</em>
        </h2>
        <p>
          把一个问题拆小，把一次运动看清。
          <br />
          这里收藏思考，也让它们运行起来。
        </p>
        <a class="text-link" href="#explore">
          走进这些小小的世界 <span>↓</span>
        </a>
      </div>
      <div class="orbit-meter" aria-hidden="true">
        <span id="orbit-progress"></span>
      </div>
      <span class="moon-caption">LUNAR STUDY / 光与尘的练习</span>
    </div>
  </section>
  <section class="section wrap selected-projects" id="explore">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow">01 / SELECTED EXPLORATIONS</p>
        <h2>
          探索，<span>从一个小问题开始。</span>
        </h2>
      </div>
      <a class="text-link" href="/projects/">
        全部探索 <span>↗</span>
      </a>
    </div>
    <a
      class="project-feature project-link"
      href="/lab/?example=pendulum"
      data-reveal
    >
      <div class="project-image">
        <ProjectArt kind="pendulum" />
        <span class="image-label">INTERACTIVE STUDY 001</span>
        <span class="project-open" aria-hidden="true">
          ↗
        </span>
      </div>
      <div class="project-meta">
        <div>
          <span class="eyebrow">MUJOCO / JOINT DYNAMICS</span>
          <h3>一枚摆，和时间的形状。</h3>
        </div>
        <p>
          改变阻尼，观察能量如何悄然退场。
          <br />
          从最简单的运动，理解仿真的第一步。
        </p>
        <span class="project-index">01</span>
      </div>
    </a>
    <div class="project-pair">
      <a class="project-link" href="/lab/?example=actuator" data-reveal>
        <div class="project-image">
          <ProjectArt kind="actuator" />
          <span class="image-label">INTERACTIVE STUDY 002</span>
          <span class="project-open" aria-hidden="true">
            ↗
          </span>
        </div>
        <div class="project-meta">
          <div>
            <span class="eyebrow">MUJOCO / ACTUATION</span>
            <h3>向一个目标，慢慢靠近。</h3>
          </div>
          <span class="project-index">02</span>
        </div>
        <p class="project-summary">位置执行器 · 目标与响应</p>
      </a>
      <a class="project-link" href="/lab/?example=contact" data-reveal>
        <div class="project-image">
          <ProjectArt kind="contact" />
          <span class="image-label">INTERACTIVE STUDY 003</span>
          <span class="project-open" aria-hidden="true">
            ↗
          </span>
        </div>
        <div class="project-meta">
          <div>
            <span class="eyebrow">MUJOCO / CONTACT</span>
            <h3>在接触的地方，发生什么。</h3>
          </div>
          <span class="project-index">03</span>
        </div>
        <p class="project-summary">滑动摩擦 · 接触与停止</p>
      </a>
    </div>
  </section>
  <section class="lab-invitation" data-reveal>
    <div class="wrap lab-invitation-inner">
      <div class="lab-symbol" aria-hidden="true">
        <span></span>
        <i></i>
        <b></b>
      </div>
      <div>
        <p class="eyebrow">THE SMALL LABORATORY</p>
        <h2>
          亲手改变一个参数，
          <br />
          <span>看世界如何回应。</span>
        </h2>
        <p>
          可以暂停，可以重来。
          <br />
          在浏览器里，把好奇变成一次小实验。
        </p>
        <a class="text-link" href="/lab/">
          进入实验室 <span>↗</span>
        </a>
      </div>
      <span class="vertical-note">OBSERVE · ADJUST · UNDERSTAND</span>
    </div>
  </section>
  <section class="section wrap journal-section">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow">02 / FIELD NOTES</p>
        <h2>
          手记，<span>沿途留下的思考。</span>
        </h2>
      </div>
      <a class="text-link" href="/journal/">
        全部手记 <span>↗</span>
      </a>
    </div>
    <div class="journal-list">
      <a href="/journal/pendulum/" data-reveal>
        <span class="note-number">001</span>
        <div>
          <span class="eyebrow">仿真札记 / 6 MIN READ</span>
          <h3>从一枚单摆开始，理解 MuJoCo。</h3>
        </div>
        <span class="note-arrow">↗</span>
      </a>
      <a href="/journal/actuator/" data-reveal>
        <span class="note-number">002</span>
        <div>
          <span class="eyebrow">控制入门 / 5 MIN READ</span>
          <h3>目标、误差，以及抵达的过程。</h3>
        </div>
        <span class="note-arrow">↗</span>
      </a>
      <a href="/journal/contact/" data-reveal>
        <span class="note-number">003</span>
        <div>
          <span class="eyebrow">观察笔记 / 4 MIN READ</span>
          <h3>让一个方块滑行，直到它停下来。</h3>
        </div>
        <span class="note-arrow">↗</span>
      </a>
    </div>
  </section>
  <section class="about-fragment wrap" data-reveal>
    <p class="eyebrow">A NOTE FROM FEEDSTAR</p>
    <p class="about-quote">
      有些理解，来自阅读。
      <br />
      有些理解，<span>要让它发生一次。</span>
    </p>
    <div>
      <p>
        这是我的个人空间，存放工作与学习中的文章、
        <br class="desktop-break" />
        可视化程序，以及关于运动与仿真的小实验。
      </p>
      <a class="text-link" href="/about/">
        关于这个空间 <span>↗</span>
      </a>
    </div>
  </section>
</Layout>
