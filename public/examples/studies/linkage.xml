<!-- Feedstar original: planar parallelogram with an explicit loop closure. -->
<mujoco model="Feedstar four bar">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast"/>
  <default>
    <joint axis="0 0 1" damping="0.12" armature="0.005"/>
    <geom type="capsule" size="0.025" density="900" contype="0" conaffinity="0" rgba="0.8 0.84 0.81 1"/>
    <site size="0.012" rgba="0.8 0.6 0.3 1"/>
  </default>
  <worldbody>
    <geom name="base" type="box" size="0.43 0.12 0.035" pos="0.325 0 0.035" rgba="0.13 0.18 0.2 1"/>
    <geom type="cylinder" size="0.045 0.09" pos="0 0 0.13" rgba="0.4 0.68 0.63 1"/>
    <geom type="cylinder" size="0.045 0.09" pos="0.65 0 0.13" rgba="0.4 0.68 0.63 1"/>
    <body name="input" pos="0 0 0.24">
      <joint name="crank"/>
      <geom fromto="0 0 0 0 0.32 0" rgba="0.4 0.68 0.63 1"/>
      <body name="coupler" pos="0 0.32 0">
        <joint name="elbow"/>
        <geom fromto="0 0 0 0.65 0 0"/>
        <site name="closure_a" pos="0.65 0 0"/>
        <site name="trace" pos="0.325 0 0"/>
      </body>
    </body>
    <body name="follower" pos="0.65 0 0.24">
      <joint name="rocker"/>
      <geom fromto="0 0 0 0 0.32 0" rgba="0.8 0.6 0.3 1"/>
      <site name="closure_b" pos="0 0.32 0"/>
    </body>
  </worldbody>
  <equality><connect name="loop" site1="closure_a" site2="closure_b" solref="0.008 1"/></equality>
  <actuator><position name="drive" joint="crank" kp="100" kv="6" forcerange="-20 20"/></actuator>
</mujoco>
