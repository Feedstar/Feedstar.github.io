<mujoco model="Feedstar - sliding friction">
  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"/>
  <default><geom friction="0.25 0.005 0.0001" condim="3"/></default>
  <worldbody>
    <geom name="floor" type="plane" size="4 4 .1" rgba=".25 .31 .25 1"/>
    <body name="block" pos="-1 0 .15">
      <joint name="slide_x" type="slide" axis="1 0 0"/>
      <joint name="slide_z" type="slide" axis="0 0 1"/>
      <geom name="cube" type="box" size=".15 .15 .15" mass="1" rgba=".65 .73 .56 1"/>
    </body>
  </worldbody>
  <keyframe><key name="initial" qpos="0 0.002" qvel="2 0"/></keyframe>
</mujoco>
